---
import icons from './site/social-icons.json';
import infinumLogo from './site/infinum-logo.svg?raw';

const links = [
	['Facebook', 'https://facebook.com/infinumcom'],
	['Instagram', 'https://instagram.com/infinumcom/'],
	['Twitter', 'https://twitter.com/infinum'],
	['Clutch', 'https://clutch.co/profile/infinum'],
	['Dribbble', 'https://dribbble.com/infinum'],
	['LinkedIn', 'https://linkedin.com/company/infinum/'],
];
---

<footer class="community-footer" aria-label="Community" data-pagefind-ignore>
	<div class="footer-row">
		<a class="brand" href="https://infinum.com/" aria-label="Infinum home"><span aria-hidden="true" set:html={infinumLogo} /></a>
		<p>Made with ❤️ by <a href="https://infinum.com/">Infinum Team</a>.</p>
		<ul role="list" aria-label="Social links">
			{links.map(([label, href]) => (
				<li><a class="social-link" href={href} aria-label={label} title={label}>
					<span set:html={icons[href as keyof typeof icons]} />
				</a></li>
			))}
		</ul>
	</div>
</footer>

<style>
	.community-footer { container-type: inline-size; position: relative; z-index: var(--sl-z-index-menu); padding: 2rem clamp(1rem, 5vw, 5rem); border-top: 1px solid var(--sl-color-hairline-shade); background: transparent; color: var(--sl-color-gray-2); }
	.footer-row { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem; }
	.brand { justify-self: start; color: var(--sl-color-white); }
	.brand span { display: flex; }
	.brand :global(svg) { width: 160px; max-width: 100%; height: auto; }
	p { text-align: center; }
	@container (max-width: 44rem) {
		.footer-row { grid-template-columns: 1fr; justify-items: center; gap: 1.25rem; }
		.brand, .footer-row ul { justify-self: center; }
	}
	.social-link { display: inline-flex; align-items: center; justify-content: center; width: 2.25rem; height: 2.75rem; border-radius: .5rem; }
	.social-link span { display: flex; }
	.social-link:hover { background: var(--sl-color-bg-inline-code); }
	.community-footer .social-link:focus-visible { border-radius: .5rem; }
	ul { display: flex; justify-self: end; flex-wrap: wrap; justify-content: center; gap: 0; padding: 0; margin: 0; list-style: none; }
	li, p { margin: 0; font-size: var(--sl-text-sm); }
	a { color: inherit; text-decoration: none; text-underline-offset: .25em; }
	a:hover { color: var(--sl-color-text-accent); text-decoration: underline; }
	a:focus-visible { outline: 2px solid var(--sl-color-text-accent); outline-offset: 4px; border-radius: .125rem; }
</style>
